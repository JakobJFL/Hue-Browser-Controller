# Philips Hue Remote API OAuth Client ID (public, safe in frontend)
VITE_HUE_CLIENT_ID=your_hue_client_id_here

# Optional: Philips Hue App ID (from developers.meethue.com/my-apps)
VITE_HUE_APP_ID=open-hue-controller

# Deployed Cloudflare Worker URL (no trailing slash)
VITE_WORKER_URL=https://open-hue-controller-proxy.your-subdomain.workers.dev

# Optional: Cloudflare Web Analytics site token (cookieless, public)
VITE_CF_ANALYTICS_TOKEN=
